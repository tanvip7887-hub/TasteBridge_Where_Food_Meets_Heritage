PORT=5000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL="postgresql://USERNAME:PASSWORD@localhost:5432/tastebridge"
JWT_SECRET="your_jwt_secret_key_here"
JWT_EXPIRES_IN="7d"
ORDER_CANCELLATION_WINDOW_MINUTES=5
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=

# Feature Flags
EMAIL_ENABLED=true
RABBITMQ_ENABLED=false

# Email / Gmail SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="TasteBridge <no-reply@tastebridge.com>"
EMAIL_FROM="TasteBridge <no-reply@tastebridge.com>"

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# RabbitMQ Message Broker Configuration (Optional / Future asynchronous queue integration)
# RABBITMQ_URL=amqp://localhost:5672
# RABBITMQ_EMAIL_QUEUE=tastebridge.email

# Maximum comments each authenticated account may create per minute (1-100; default 10)
SOCIAL_COMMENT_RATE_LIMIT_PER_MINUTE=10
